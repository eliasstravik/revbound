{
  "name": "revbound",
  "version": "0.0.7",
  "description": "The open-source agent plugin that runs your GTM: workflows your agent writes, run on Vercel, with a record of every run and dollar and a console for your team.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasstravik/revbound.git"
  },
  "type": "module",
  "bin": {
    "revbound": "dist/core/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "starter",
    "example",
    "skills",
    "src/plugins",
    "plugin.json",
    ".claude-plugin",
    ".cursor-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/core/proxy.d.ts",
      "default": "./dist/core/proxy.js"
    },
    "./server": {
      "types": "./dist/core/server.d.ts",
      "default": "./dist/core/server.js"
    },
    "./next": {
      "types": "./dist/core/next.d.ts",
      "default": "./dist/core/next.js"
    },
    "./cli": {
      "types": "./dist/cli-kit.d.ts",
      "default": "./dist/cli-kit.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./kit/*": {
      "types": "./dist/kit/*.d.ts",
      "default": "./dist/kit/*.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./database": {
      "types": "./dist/plugins/database/index.d.ts",
      "default": "./dist/plugins/database/index.js"
    },
    "./database/runtime": {
      "types": "./dist/plugins/database/runtime.d.ts",
      "workflow": "./dist/plugins/database/runtime-workflow.js",
      "default": "./dist/plugins/database/runtime.js"
    },
    "./database/*": {
      "types": "./dist/plugins/database/*.d.ts",
      "default": "./dist/plugins/database/*.js"
    },
    "./ledger": {
      "types": "./dist/plugins/ledger/index.d.ts",
      "default": "./dist/plugins/ledger/index.js"
    },
    "./ledger/*": {
      "types": "./dist/plugins/ledger/*.d.ts",
      "default": "./dist/plugins/ledger/*.js"
    },
    "./workflows": {
      "types": "./dist/plugins/workflows/index.d.ts",
      "default": "./dist/plugins/workflows/index.js"
    },
    "./workflows/*": {
      "types": "./dist/plugins/workflows/*.d.ts",
      "default": "./dist/plugins/workflows/*.js"
    },
    "./ai": {
      "types": "./dist/plugins/ai/index.d.ts",
      "default": "./dist/plugins/ai/index.js"
    },
    "./ai/*": {
      "types": "./dist/plugins/ai/*.d.ts",
      "default": "./dist/plugins/ai/*.js"
    },
    "./context": {
      "types": "./dist/plugins/context/index.d.ts",
      "default": "./dist/plugins/context/index.js"
    },
    "./context/*": {
      "types": "./dist/plugins/context/*.d.ts",
      "default": "./dist/plugins/context/*.js"
    },
    "./connections": {
      "types": "./dist/plugins/connections/index.d.ts",
      "default": "./dist/plugins/connections/index.js"
    },
    "./connections/*": {
      "types": "./dist/plugins/connections/*.d.ts",
      "default": "./dist/plugins/connections/*.js"
    },
    "./console": {
      "types": "./dist/plugins/console/index.d.ts",
      "default": "./dist/plugins/console/index.js"
    },
    "./console/*": {
      "types": "./dist/plugins/console/*.d.ts",
      "default": "./dist/plugins/console/*.js"
    },
    "./mdm": {
      "types": "./dist/plugins/mdm/index.d.ts",
      "default": "./dist/plugins/mdm/index.js"
    },
    "./mdm/*": {
      "types": "./dist/plugins/mdm/*.d.ts",
      "default": "./dist/plugins/mdm/*.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/assets.mjs && chmod +x dist/core/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run build && node --test test/unit/*.test.mjs",
    "test": "npm run check && node --test test/ledger/*.test.mjs test/mdm/*.test.mjs && node --test test/acceptance.test.mjs",
    "lines": "node scripts/lines.mjs",
    "version:bump": "node scripts/version.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@electric-sql/pglite": "~0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@next/env": "^16.4.2",
    "@vercel/oidc": "4.0.1",
    "marked": "18.1.1",
    "pg": "8.23.1",
    "jiti": "2.7.0"
  },
  "peerDependencies": {
    "@ai-sdk/workflow": "^2.0.75",
    "ai": "^7.0.143",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workflow": "^5.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/workflow": "2.0.75",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "ai": "7.0.143",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "workflow": "5.2.2",
    "zod": "4.6.7"
  }
}
